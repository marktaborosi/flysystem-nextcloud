# Copy to .env to override the defaults used by docker-compose.yml.
# If you change the port or credentials, also export NEXTCLOUD_BASE_URI,
# NEXTCLOUD_USERNAME and NEXTCLOUD_PASSWORD for PHPUnit (see phpunit.xml.dist).

# Official image tag: stable-apache (newest major) or production-apache (previous major), or e.g. 33-apache
NEXTCLOUD_IMAGE_TAG=stable-apache
NEXTCLOUD_HTTP_PORT=8080

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin
